{
  "name": "@autoscore/server",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node --import jiti/register src/main.ts",
    "dev": "AUTOSCORE_AUTH=${AUTOSCORE_AUTH:-off} node --watch --import jiti/register src/main.ts",
    "bench": "node --import jiti/register scripts/bench-lists.ts"
  },
  "dependencies": {
    "@autoscore/engine": "workspace:*",
    "@autoscore/schema": "workspace:*",
    "@fastify/cors": "^11.4.3",
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "jiti": "^2.7.0",
    "kysely": "^0.29.9"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "vitest": "^5.1.0"
  }
}
