# Wzór pliku /etc/autoscore/autoscore.env (właściciel root:autoscore, prawa 640).
# systemd nie zna komentarzy na końcu linii, więc każdy komentarz stoi w osobnej linii.

# Adres nasłuchu. "::" przyjmuje połączenia po IPv6, którym przychodzi ruch z subdomeny Mikr.us.
HOST=::
# Port aplikacji. Darmowa subdomena <serwer>-3000.mikrus.cloud kieruje ruch na port 3000.
PORT=3000
# Bezwzględna ścieżka bazy poza katalogiem z kodem, bo usługa działa w packages/server.
DATABASE_PATH=/home/autoscore/data/autoscore.sqlite
# Wspólne hasło do logowania. Pusta wartość wyłącza logowanie, co na publicznym serwerze nie jest bezpieczne.
AUTOSCORE_PASSWORD=zmien-to-haslo
# Klucz do podpisu tokenów, co najmniej 32 znaki. Wygeneruj go przez openssl rand -base64 48.
AUTOSCORE_TOKEN_SECRET=wklej-tu-wygenerowany-sekret
# Katalog packages/web/dist w katalogu z kodem. Pusta wartość wyłącza serwowanie i budowanie frontu.
AUTOSCORE_WEB_DIR=/home/autoscore/app/packages/web/dist
# Publiczny adres aplikacji. Build frontu używa go jako adresu API.
AUTOSCORE_PUBLIC_URL=https://app.example
# Ile minut po rzutce kończącej grę da się jeszcze cofać. 0 zamyka grę od razu.
AUTOSCORE_MATCH_LOCK_MINUTES=5
# Origin frontu na innym adresie niż API: sam schemat i host, bez ścieżki i bez końcowego ukośnika. Kilka originów oddziel przecinkami.
# Zostaje pusta, gdy front i API działają pod jednym adresem.
AUTOSCORE_CORS_ORIGIN=
